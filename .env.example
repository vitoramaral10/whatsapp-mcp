# Copy to .env and uncomment what you need. Every variable is optional.

# Pair by typing a code on the phone instead of scanning a QR (country code, digits only).
# WHATSAPP_PAIR_PHONE=

# Listeners. Keep them off public interfaces: neither endpoint has authentication.
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# WHATSAPP_API_HOST=0.0.0.0
# WHATSAPP_API_PORT=8080

# Limit what a client can do.
# WHATSAPP_READ_ONLY=true
# WHATSAPP_ALLOWED_CHATS=5511900000000,120363000000000000@g.us

# Directories send_file and /api/send may read from (':'-separated).
# WHATSAPP_SEND_DIRS=/app/envios

# Public base URL of the upload listener: send_file can then hand the client a one-shot
# URL to PUT a file from its own disk to. Publish the port only where the clients are.
# WHATSAPP_UPLOAD_URL=http://homelab:8090
# WHATSAPP_UPLOAD_PORT=8090

# Host side of the store bind mount, so returned media paths open on the host.
# WHATSAPP_MEDIA_HOST_PATH=/srv/whatsapp/store
# WHATSAPP_MEDIA_MAX_INLINE_BYTES=8388608

# Semantic search (OpenAI-compatible /v1/embeddings).
# EMBED_URL=http://embeddings:8080
# EMBED_MODEL=bge-m3

# Voice-note transcription (whisper.cpp server).
# WHISPER_URL=http://whisper:8080
# WHISPER_WAIT_S=10
# WHISPER_TIMEOUT_S=180

# WHATSAPP_LOG_LEVEL=info
